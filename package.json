{
  "name": "utilful",
  "type": "module",
  "version": "3.3.0",
  "packageManager": "pnpm@11.25.0",
  "description": "A collection of TypeScript utilities",
  "author": "Johann Schopplich <hello@johannschopplich.com>",
  "license": "MIT",
  "homepage": "https://github.com/johannschopplich/utilful#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johannschopplich/utilful.git"
  },
  "bugs": {
    "url": "https://github.com/johannschopplich/utilful/issues"
  },
  "keywords": [
    "cli",
    "csv",
    "defu",
    "emitter",
    "result",
    "typescript",
    "url",
    "utilities"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./array": {
      "types": "./dist/array.d.mts",
      "default": "./dist/array.mjs"
    },
    "./cli": {
      "types": "./dist/cli/index.d.mts",
      "default": "./dist/cli/index.mjs"
    },
    "./cli/testing": {
      "types": "./dist/cli/testing.d.mts",
      "default": "./dist/cli/testing.mjs"
    },
    "./csv": {
      "types": "./dist/csv.d.mts",
      "default": "./dist/csv.mjs"
    },
    "./defu": {
      "types": "./dist/defu.d.mts",
      "default": "./dist/defu.mjs"
    },
    "./emitter": {
      "types": "./dist/emitter.d.mts",
      "default": "./dist/emitter.mjs"
    },
    "./json": {
      "types": "./dist/json.d.mts",
      "default": "./dist/json.mjs"
    },
    "./module": {
      "types": "./dist/module.d.mts",
      "default": "./dist/module.mjs"
    },
    "./object": {
      "types": "./dist/object.d.mts",
      "default": "./dist/object.mjs"
    },
    "./path": {
      "types": "./dist/path.d.mts",
      "default": "./dist/path.mjs"
    },
    "./result": {
      "types": "./dist/result.d.mts",
      "default": "./dist/result.mjs"
    },
    "./string": {
      "types": "./dist/string.d.mts",
      "default": "./dist/string.mjs"
    },
    "./types": {
      "types": "./dist/types.d.mts",
      "default": "./dist/types.mjs"
    }
  },
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest",
    "test:types": "tsc --noEmit",
    "release": "bumpp"
  },
  "peerDependencies": {
    "vitest": ">=4"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.0",
    "@types/node": "^26.4.1",
    "bumpp": "^12.2.2",
    "eslint": "^10.9.1",
    "eslint-flat-config-utils": "^3.2.0",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
